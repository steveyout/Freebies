# Application Environment Variables
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL Dialect via Sequelize)
# If MySQL connection parameters are not provided, an automatic SQLite fallback is used for dev.
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freebies_directory
DB_USER=root
DB_PASSWORD=your_secure_mysql_password

# Authentication Secret
JWT_SECRET=freebies-super-secret-jwt-key-2026-secure

# Default Pre-seeded Admin Credentials:
# Email: admin@freebies.directory
# Password: Admin123!Secure

# Google Analytics (gtag.js)
NEXT_PUBLIC_GA_ID=G-HHK1B8QGWH
